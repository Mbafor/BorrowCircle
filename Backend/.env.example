PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://borrowcircle:borrowcircle@localhost:5433/borrowcircle

# Comma-separated list of email domains allowed to register (no @ prefix)
ALLOWED_EMAIL_DOMAINS=st.knust.edu.gh

# Used to build links in emails (e.g. the password reset link)
FRONTEND_URL=http://localhost:5173

# Secret used to sign short-lived JWT access tokens. Use a long random string in every environment.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m

# Refresh tokens are opaque random tokens (not JWTs); only their hash is stored in the DB.
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# Password reset tokens are single-use and expire after this many minutes.
PASSWORD_RESET_EXPIRES_IN_MINUTES=60

# bcrypt cost factor for password hashing.
BCRYPT_SALT_ROUNDS=12
