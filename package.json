{
  "name": "borrowcircle",
  "private": true,
  "version": "1.0.0",
  "description": "Campus marketplace web app for KNUST students to borrow and rent items from each other",
  "workspaces": [
    "Frontend",
    "Backend"
  ],
  "scripts": {
    "prepare": "husky",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:server": "npm run dev --workspace=backend",
    "dev:client": "npm run dev --workspace=frontend",
    "build:server": "npm run build --workspace=backend",
    "build:client": "npm run build --workspace=frontend",
    "lint:server": "npm run lint --workspace=backend",
    "lint:client": "npm run lint --workspace=frontend",
    "db:generate": "npm run db:generate --workspace=backend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:studio": "npm run db:studio --workspace=backend"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
